{
  "name": "portfolio",
  "version": "0.0.0",
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@davidvornholt/standards": "0.26.0",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "26",
    "bun": "1.3.14"
  },
  "packageManager": "bun@1.4.0",
  "private": true,
  "scripts": {
    "standards": "standards",
    "check": "standards check && turbo run lint check-types test build test:a11y --output-logs=errors-only",
    "check:fix": "standards check && turbo run lint:fix check-types test build test:a11y --output-logs=errors-only",
    "test:a11y": "turbo run test:a11y",
    "dev": "turbo run dev --filter=@portfolio/web",
    "build": "turbo run build --filter=@portfolio/web",
    "start": "turbo run start --filter=@portfolio/web"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
